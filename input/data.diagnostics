# diagnostics Package

&diagnostics_list
# 3D variables.
 filename(1)   = 'spinup',
 frequency(1)  = -930,
 timePhase(1)  = 1071360,
 fields(1:8,1) = 'UVEL    ',
                 'VVEL    ',
                 'WVEL    ',
                 'THETA   ',
                 'PHIHYD  ',
                 'TRAC01  ',
                 'TRAC02  ',
                 'TRAC03  ',
#
# filename(2)   = 'spinup2d',
# frequency(2)  = -930,
# timePhase(2)  = 0,
# fields(1:2,2) = 'ETAN    ',
#                 'PHIBOT  ',
#

 fileName(2) = 'layHsnap',
 fields(1:1,2) = 'LaHw1TH ',
 frequency(2) = -44640.0,
 timePhase(2) = 0.0,

 filename(3) = 'dissipation',
 frequency(3) = -930,
 timePhase(3) = 1071360,
 fields(1:2,3) = 'KLeps   ',
                 'KLviscAr',
# tidal average
 filename(4)   = 'tideave',
 frequency(4)  = 44640,
 timePhase(4)  = 0,
# Eulerian buoyancy-budget terms (for <w db/dz> vs <w><N^2>):
# - WVEL    : w
# - DRHODR  : d(rho)/dz  -> N^2 = -(g/rho0)*DRHODR
# - WdRHOdP : w*d(rho)/dz -> <w db/dz> = -(g/rho0)*<WdRHOdP>
# DRHODR  |SM      LR|kg/m^4          |Stratification: d.Sigma/dr (kg/m3/r_unit)
# WdRHO_P |WM      LR|kg/m^2/s        |Vertical velocity times delta^k(Rho)_at-const-P
# URHOMASS|UUr     MR|kg/m^2/s        |Zonal Transport of Density
# WRHOMASS|WM      LR|kg/m^2/s        |Vertical Transport of Density
# ADVr_TH |WM      LR|degC.m^3/s      |Vertical   Advective Flux of Pot.Temperature
# ADVx_TH |UU      MR|degC.m^3/s      |Zonal      Advective Flux of Pot.Temperature
# DFrE_TH |WM      LR|degC.m^3/s      |Vertical Diffusive Flux of Pot.Temperature(Explicit part)
# DFxE_TH |UU      MR|degC.m^3/s      |Zonal      Diffusive Flux of Pot.Temperature
# DFrI_TH |WM      LR|degC.m^3/s      |Vertical Diffusive Flux of Pot.Temperature (Implicit part)
 fields(1:18,4) = 'UVEL    ',
                'VVEL    ',
                'WVEL    ',
                'THETA   ',
                'PHIHYD  ',
                'URHOMASS',
                'WRHOMASS',
                'DRHODR  ',
                'WdRHO_P ',
                'ADVr_TH ',
                'ADVx_TH ',
                'DFrE_TH ',
                'DFxE_TH ',
                'DFrI_TH ',
                'KLeps   ',
                'KLviscAr',

# Residual mean flow - Layers Package
# fields(1:5,5) = 'LaUH1TH ',
#                 'LaHw1TH ',
#                 'LaVH1TH ',
# frequency(5) = 44640,
# fileName(5) = 'layDiag',
# Layers thermo fields;  Cant mix with above it seems?
fields(1:3,5) = 'LaTz1TH ',
                'LTha1TH ',
                'LTza1TH ',
 frequency(5) = 44640,
 fileName(5) = 'layTher',

fields(1:2,6) = 'LaUH1TH ',
                'LaHw1TH ',
 frequency(6) = 44640,
 fileName(6) = 'layDiag',

# tidal average
#
#
# frequency(3)  = -3600,
# timePhase(3)  = 777600,
# fields(1:5,3) = 'UVEL    ',
#                 'VVEL    ',
#                 'WVEL    ',
#                 'THETA   ',
#                 'PHIHYD  ',
# filename(3)   = 'final'
#
# filename(4)   = 'final2d'
# frequency(4)  = -3600,
# timePhase(4)  = 777600,
# fields(1:2,4) = 'ETAN    ',
#                 'PHIBOT  ',
#
/

&diag_statis_parms
/
