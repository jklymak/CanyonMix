 frequency(1)  = -930,
 timePhase(1)  = 0,
 fields(1:9,1) = 'UVEL    ',
                 'VVEL    ',
                 'WVEL    ',
                 'THETA   ',
                 'PHIHYD  ',
                 'TRAC01  ',
                 'TRAC02  ',
                 'TRAC03  ',
                 'DFrI_TH '
#
