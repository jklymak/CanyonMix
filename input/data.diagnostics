 frequency(4)  = 44640,
 timePhase(4)  = 0,
 fields(1:12,4) = 'UVEL    ',
                'VVEL    ',
                'WVEL    ',
                'THETA   ',
                'PHIHYD  ',
                'TRAC01  ',
                'TRAC02  ',
                'TRAC03  ',
                'TRAC04  ',
                'DFrI_TH ',
                'KLeps   ',
                'KLviscAr',

# Residual mean flow - Layers Package
